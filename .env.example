# =======================================================
# Kiosk Hisobot Adminka - Environment Configuration Example
# Copy this file to .env and configure real secrets for production.
# =======================================================

# Flask Secret Key for Token Signatures (URLSafeTimedSerializer)
SECRET_KEY=your-random-32-byte-secret-key-here

# Master Administrator Password for Initial Bootstrap
ADMIN_PASSWORD=your-secure-admin-password-here

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5050,http://127.0.0.1:5050,https://kiosk-xisobot-adminka.pages.dev

# External URL for Self-Ping Keep-Alive Monitor (e.g. on Render.com)
RENDER_EXTERNAL_URL=https://kiosk-xisobot-adminka.onrender.com

# Server Listening Port
PORT=5050
